rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidTimestamp(val) {
      return val is timestamp && val <= request.time;
    }

    function isValidUserSettings(data, userId) {
      return data.userId == userId &&
        data.cityName is string && data.cityName.size() > 0 && data.cityName.size() <= 100 &&
        data.methodId is string && data.methodId.size() > 0 && data.methodId.size() <= 50 &&
        data.madhhabId is string && data.madhhabId.size() > 0 && data.madhhabId.size() <= 50 &&
        (!('useAutoLocation' in data) || data.useAutoLocation is bool) &&
        (!('countryName' in data) || (data.countryName is string && data.countryName.size() <= 100)) &&
        (!('latitude' in data) || data.latitude is number) &&
        (!('longitude' in data) || data.longitude is number) &&
        (!('timezoneHours' in data) || data.timezoneHours is number) &&
        (!('voiceId' in data) || (data.voiceId is string && data.voiceId.size() <= 50)) &&
        (!('fajrVoiceId' in data) || (data.fajrVoiceId is string && data.fajrVoiceId.size() <= 50)) &&
        (!('volume' in data) || (data.volume is number && data.volume >= 0.0 && data.volume <= 1.0)) &&
        (!('isDarkTheme' in data) || data.isDarkTheme is bool) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidPrayerLog(data, userId) {
      return data.userId == userId &&
        data.dateString is string && data.dateString.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.prayerType is string && data.prayerType in ['fajr', 'sunrise', 'dhuhr', 'asr', 'maghrib', 'isha'] &&
        data.isCompleted is bool &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    match /users/{userId} {
      match /settings/{settingId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
          isValidUserSettings(request.resource.data, userId);
        allow update: if isOwner(userId) &&
          isValidUserSettings(request.resource.data, userId) &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }

      match /prayer_logs/{logId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
          isValidPrayerLog(request.resource.data, userId);
        allow update: if isOwner(userId) &&
          isValidPrayerLog(request.resource.data, userId) &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }
    }
  }
}
